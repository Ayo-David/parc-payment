NODE_ENV=development
PORT=3004
HOST=0.0.0.0
DATABASE_URL=postgresql:///parc_payment
TENANT_ADMIN_URL=http://127.0.0.1:3002
LEDGER_URL=http://127.0.0.1:3003
# Inbound: Auth-issued tokens for the parc-payment audience, verified via JWKS.
AUTH_JWKS_URL=http://127.0.0.1:3001/.well-known/jwks.json
AUTH_JWT_ISSUER=https://auth.parc.invalid
# Outbound: this service's ES256 key, registered (public half) in Auth &
# Customer SERVICE_CLIENT_KEYS_JSON under "parc-payment".
AUTH_TOKEN_URL=http://127.0.0.1:3001/internal/v1/oauth/token
SERVICE_CLIENT_KEY_ID=parc-payment-1
SERVICE_CLIENT_PRIVATE_KEY_BASE64=replace-with-base64-pkcs8-es256-private-key
PAYSTACK_SECRET_KEY=replace-with-paystack-secret
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_KEY_VERSION=default
# Monnify Bills Payment must be activated on the merchant account before startup.
MONNIFY_API_KEY=replace-with-monnify-api-key
MONNIFY_CLIENT_SECRET=replace-with-monnify-client-secret
MONNIFY_BASE_URL=https://sandbox.monnify.com
# BankOne is optional and must remain unset until Platform Admin enables it.
# Never commit live values. Load production secrets from the deployment secret store.
BANKONE_AUTH_TOKEN=
BANKONE_APPZONE_ACCOUNT=
BANKONE_CHANNEL_BASE_URL=https://staging.mybankone.com
BANKONE_CORE_BASE_URL=https://staging.mybankone.com
BANKONE_INTERBANK_TSQ_PATH=/thirdpartyapiservice/apiservice/CoreTransactions/TransactionStatusQuery
BILL_INQUIRY_WORKER_ID=bill-inquiry-worker-1
BILL_INQUIRY_INTERVAL_MS=10000
